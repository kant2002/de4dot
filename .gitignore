*~
.vs/
bin/
obj/
Release/
Debug/
publish-netcoreapp*/
publish-net*/
launchSettings.json
*.user

# Build output
/net4*/
/net[0-9]*.[0-9]*/

# Rider (Sourced from https://github.com/JetBrains/resharper-rider-samples/blob/master/.gitignore)

# Rider User specific
**/.idea/**/workspace.xml
**/.idea/**/tasks.xml
**/.idea/shelf/*
**/.idea/dictionaries
**/.idea/httpRequests/

# Rider Sensitive or high-churn files
**/.idea/**/dataSources/
**/.idea/**/dataSources.ids
**/.idea/**/dataSources.xml
**/.idea/**/dataSources.local.xml
**/.idea/**/sqlDataSources.xml
**/.idea/**/dynamic.xml

# Rider auto-generates .iml files, and contentModel.xml
**/.idea/**/*.iml
**/.idea/**/contentModel.xml
**/.idea/**/modules.xml
