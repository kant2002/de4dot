<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Tests run on the modern target only. The code under test is the same source for net48, and
         the multi-targeted build of the referenced projects already proves it compiles there. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
    <!-- Directory.Build.props turns these on for the shipped executables. A test assembly is loaded
         by the test host, so single-file/self-contained publishing does not apply and leaving them
         set fails the build with NETSDK1191. Strong-naming is likewise pointless here. -->
    <SignAssembly>false</SignAssembly>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- Keep test output out of the shared Release/ directory the real projects publish into. -->
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- Project references, never a HintPath to a build output: the tests must be built from the same
       sources as the rest of the solution, and no binary belongs in the repository. dnlib arrives
       transitively from de4dot.blocks. -->
  <ItemGroup>
    <ProjectReference Include="..\..\de4dot.blocks\de4dot.blocks.csproj" />
    <ProjectReference Include="..\..\de4dot.code\de4dot.code.csproj" />
  </ItemGroup>

</Project>
